PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/ruralcare
# Use a long random string, e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# REQUIRED. Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-generate-a-long-random-value
# Comma separated list of allowed frontend origins (leave empty to allow all in development)
CLIENT_ORIGIN=http://localhost:5173
# Where uploaded medical report files are stored (private folder, never served publicly).
# Default: server/storage/reports. Use an absolute path on a persistent disk in production.
REPORTS_DIR=
# Maximum report upload size in MB (default 10)
MAX_REPORT_MB=10
# Timezone printed on prescription PDFs (default Asia/Kolkata)
APP_TIMEZONE=Asia/Kolkata
# Set to 1 when running behind one reverse proxy (nginx etc.) so login rate-limiting sees the real client IP
TRUST_PROXY=
